{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true
    },
    "release": {
      "distribution": "internal",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
