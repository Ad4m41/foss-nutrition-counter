      "description": "Visible label with a native-style field.",
      "html": "<label class=\"ds-label\">Height (cm)<input class=\"ds-field\" value=\"170\" inputmode=\"decimal\"></label>",
      "css": ".ds-label {display:block;color:#58645C;font:600 13px Manrope,system-ui;} .ds-field {display:block;margin-top:8px;min-height:50px;padding:12px;border:1px solid #E6E5DD;border-radius:10px;background:white;color:#263C32;font:600 16px Manrope,system-ui;} .ds-field:hover {border-color:#58645C;} .ds-field:focus-visible {outline:2px solid #284F3E;outline-offset:2px;}"
    },
    {
      "name": "Selected date",
      "kind": "chip",
      "refersTo": "date-selected",
      "description": "One date from the adaptive five/seven-cell strip.",
      "html": "<button class=\"ds-date\" aria-pressed=\"true\"><span>Fri</span><strong>2</strong></button>",
      "css": ".ds-date {display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-width:48px;min-height:64px;border:0;border-radius:14px;background:#284F3E;color:white;font:600 10px Manrope,system-ui;} .ds-date strong {font-size:18px;font-weight:700;} .ds-date:hover {opacity:.9;} .ds-date:active {opacity:.7;} .ds-date:focus-visible {outline:2px solid #284F3E;outline-offset:3px;}"
    },
    {
      "name": "Macro dock",
      "kind": "card",
      "refersTo": "macro-dock",
      "description": "Four labeled rails; sample totals and targets illustrate user-supplied goals.",
      "html": "<button class=\"ds-macros\" aria-label=\"Nutrition details\"><span class=\"ds-macro\"><span>Energy</span><strong>640</strong><span class=\"ds-rail\"><span style=\"width:32%;background:#A6533B\"></span></span><span>/ 2000 kcal</span></span><span class=\"ds-macro\"><span>Protein</span><strong>32</strong><span class=\"ds-rail\"><span style=\"width:32%;background:#437F97\"></span></span><span>/ 100 g</span></span><span class=\"ds-macro\"><span>Carbs</span><strong>70</strong><span class=\"ds-rail\"><span style=\"width:0%;background:#907445\"></span></span><span>g</span></span><span class=\"ds-macro\"><span>Fat</span><strong>26</strong><span class=\"ds-rail\"><span style=\"width:52%;background:#94608D\"></span></span><span>/ 50 g</span></span></button>",
      "css": ".ds-macros {display:flex;gap:12px;width:100%;padding:14px;border:0;border-radius:16px;background:white;color:#263C32;text-align:left;font:400 11px Manrope,system-ui;} .ds-macro {display:flex;flex-direction:column;gap:5px;flex:1;min-width:0;color:#58645C;} .ds-macro strong {color:#263C32;font-size:19px;font-weight:800;font-variant-numeric:tabular-nums;} .ds-rail {display:block;height:5px;border-radius:4px;background:#E6E5DD;overflow:hidden;} .ds-rail span {display:block;height:5px;border-radius:4px;} .ds-macros:hover {opacity:.9;} .ds-macros:active {opacity:.8;} .ds-macros:focus-visible {outline:2px solid #284F3E;outline-offset:3px;}"
    },
    {
      "name": "Diary navigation",
      "kind": "nav",
      "refersTo": "add-action",
      "description": "Browser translation of two tabs and central add action; native safe-area padding omitted.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><button class=\"ds-tab ds-current\" aria-current=\"page\">Diary</button><button class=\"ds-add\" aria-label=\"Add meal\"><svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 4v16M4 12h16\"/></svg></button><button class=\"ds-tab\">Settings</button></nav>",
      "css": ".ds-nav {display:flex;align-items:center;padding:0 24px 8px;border-top:1px solid #E6E5DD;background:#FAF7F2;} .ds-tab {flex:1;min-height:64px;border:0;background:transparent;color:#58645C;font:600 12px Manrope,system-ui;} .ds-current {color:#284F3E;font-weight:700;} .ds-add {display:flex;align-items:center;justify-content:center;width:58px;height:58px;margin:0 18px;border:0;border-radius:18px;background:#F1BE9B;color:#543727;} .ds-tab:hover,.ds-add:hover {opacity:.9;} .ds-add:active {transform:scale(.94);} .ds-tab:focus-visible,.ds-add:focus-visible {outline:2px solid #284F3E;outline-offset:2px;}"
    },
    {
      "name": "Sex segmented control",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "Selected fill and explicit pressed state; preview omits native measured animation.",
      "html": "<div class=\"ds-segments\"><button aria-pressed=\"true\">Female</button><button aria-pressed=\"false\">Male</button></div>",
      "css": ".ds-segments {display:flex;padding:4px;border-radius:16px;background:#E7EDE5;} .ds-segments button {flex:1;min-height:52px;padding:14px 8px;border:0;border-radius:12px;background:transparent;color:#284F3E;font:700 15px Manrope,system-ui;} .ds-segments button[aria-pressed=\"true\"] {background:#284F3E;color:white;} .ds-segments button:hover {opacity:.9;} .ds-segments button:active {opacity:.8;} .ds-segments button:focus-visible {outline:2px solid #284F3E;outline-offset:2px;}"
    },
    {
      "name": "Age wheel",
      "kind": "custom",
      "description": "Static five-row silhouette; native snapping, haptics and adjustable actions require the app.",
      "html": "<div class=\"ds-wheel\"><div>28</div><div>29</div><div class=\"ds-age-selected\">30</div><div>31</div><div>32</div></div><div class=\"ds-age-controls\"><button aria-label=\"Age minus one\">−</button><span>30</span><button aria-label=\"Age plus one\">+</button></div>",
      "css": ".ds-wheel {color:#58645C;font:800 40px/56px Manrope,system-ui;text-align:center;background:#FAF7F2;} .ds-wheel div {height:56px;margin:0 28px;} .ds-wheel div:nth-child(1),.ds-wheel div:nth-child(5) {opacity:.12;} .ds-wheel div:nth-child(2),.ds-wheel div:nth-child(4) {opacity:.45;} .ds-wheel .ds-age-selected {border-block:1px solid #E6E5DD;border-radius:12px;background:#E7EDE5;color:#284F3E;} .ds-age-controls {display:flex;gap:24px;align-items:center;justify-content:center;color:#58645C;font:600 15px Manrope,system-ui;} .ds-age-controls button {min-width:48px;min-height:48px;border:0;background:transparent;color:#284F3E;font-size:24px;} .ds-age-controls button:hover {opacity:.9;} .ds-age-controls button:active {opacity:.7;} .ds-age-controls button:focus-visible {outline:2px solid #284F3E;}"
    },
    {
      "name": "Water container",
      "kind": "card",
      "refersTo": "water-container",
      "description": "Sample numeric total and goal track; preview omits the bundled decorative otter.",
      "html": "<section class=\"ds-water\"><strong>Water</strong><p>750 <span>/ 2000 ml</span></p><div class=\"ds-water-rail\"><div></div></div><button>+ 250 ml</button><button>+ 500 ml</button></section>",
      "css": ".ds-water {padding:18px;border-radius:16px;background:#E5F2F2;color:#263C32;font:700 19px Manrope,system-ui;} .ds-water p {font-size:24px;font-variant-numeric:tabular-nums;} .ds-water p span {color:#58645C;font-size:15px;font-weight:400;} .ds-water-rail {height:5px;background:#E6E5DD;border-radius:4px;overflow:hidden;} .ds-water-rail div {height:5px;width:37.5%;background:#267B8D;} .ds-water button {min-height:52px;margin:6px 12px 6px 0;padding:14px 18px;border:0;border-radius:12px;background:#E7EDE5;color:#284F3E;font:700 16px Manrope,system-ui;} .ds-water button:hover {opacity:.9;} .ds-water button:active {opacity:.8;} .ds-water button:focus-visible {outline:2px solid #284F3E;outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "The Warm Meal Journal",
    "overview": "Use warm cream pages, evergreen ink and apricot add controls for a calm, food-first mobile diary. Bundle Manrope for headings, labels and figures. Keep meal photos and nutrition legible in both system color schemes.\n\nThis document records the implemented source and approved visual direction. Browser captures support layout review; Android/iOS rendering, wheel gestures and Rive playback still need device review. Keep surface composition decisions in `.impeccable/surfaces/mobile.md`.",
    "keyCharacteristics": [
      "Warm cream and paired evergreen themes.",
      "Bundled Manrope with tabular nutrition figures.",
      "Apricot add controls and four labeled macro colors.",
      "Flat surfaces, open meal rows and rounded controls."
    ],
    "rules": [
      {
        "name": "Semantic Pair",
        "body": "Switch foreground and background roles together when the system color scheme changes.",
        "section": "colors"
      },
      {
        "name": "Stable Numbers",
        "body": "Use tabular numbers for nutrition, water totals and the age wheel.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the paired light and dark roles from `src/components/ui.tsx`.",
      "Do keep labels, units and selected states visible alongside color.",
      "Do preserve text scaling, wrapping and at least 48-unit touch targets.",
      "Do keep optional macro goals empty until the user supplies them.",
      "Do display unknown nutrient values and incomplete-data guidance.",
      "Do respect reduced motion in wheel transforms, progress and sheet transitions."
    ],
    "donts": [
      "Don't replace bundled Manrope with platform typography for the main hierarchy.",
      "Don't invent personalized macro targets or fill absent goals.",
      "Don't describe the otter’s changing shape as the user’s body weight.",
      "Don't treat web captures or sidecar specimens as native device approval."
    ]
  }
}
